#!/bin/bash
HERE="$(dirname "$(readlink -f "$0")")"

export APPDIR="${HERE}"

export SPA_PLUGIN_DIR="${HERE}/usr/lib/spa-0.2"
export PIPEWIRE_MODULE_DIR="${HERE}/usr/lib/pipewire-0.3"

# Fedora's ffmpeg-free uses GnuTLS, which requires a crypto-policies priority file.
export GNUTLS_SYSTEM_PRIORITY_FILE="${HERE}/usr/share/crypto-policies/DEFAULT/gnutls.txt"

# LD_LIBRARY_PATH for library resolution (bundled first; glibc and GPU/driver
# libs are not bundled and resolve from the host).
export LD_LIBRARY_PATH="${HERE}/usr/lib:${HERE}/usr/bin${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec "${HERE}/usr/bin/jellium-desktop" "$@"
